# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017
DB_NAME=ridex

# Auth
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# How far a driver may be from the pickup to be dispatched
SEARCH_RADIUS_KM=5

# ==========================================
# Maps / geocoding / routing (OpenStreetMap)
# ==========================================
# Free community services used for address search (Nominatim) and road routes,
# distance and ETA (OSRM). The backend proxies them so keys/usage stay server
# side and request volume can be rate limited. Replace with self-hosted
# instances if the community usage limits are too tight.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org

# Nominatim policy requires an identifying User-Agent. Set something that
# describes your deployment (app name + contact).
GEOCODER_USER_AGENT=RideX-AXION/1.0 (educational ride-booking project)

# Timeout for external maps calls (ms). On timeout routing falls back to a
# clearly labelled straight-line estimate instead of hanging the request.
EXTERNAL_API_TIMEOUT_MS=7000

# Set to false to work fully offline (geocoding returns no results and routing
# uses the straight-line approximation).
GEOCODING_ENABLED=true
ROUTING_ENABLED=true

# Minimum distance (km) between pickup and destination before a trip is allowed.
MIN_TRIP_DISTANCE_KM=0.05