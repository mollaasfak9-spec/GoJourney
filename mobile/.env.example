# Copy this file to `.env` and set your computer's LAN IP address.
#
# A phone cannot reach your computer through "localhost" or "127.0.0.1"
# because those mean "the phone itself". Use the Wi-Fi IP of the PC that
# runs the backend, for example:
#
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api
#
# Find the PC IP:
#   Windows : ipconfig        (look for "IPv4 Address" on your Wi-Fi adapter)
#   macOS   : ipconfig getifaddr en0
#   Linux   : hostname -I
#
# The `/api` suffix is required (every backend route starts with /api).
#
# Anything in this file that starts with EXPO_PUBLIC_ is bundled into the
# app and is NOT secret. Never put API keys, passwords or the JWT secret here.
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_IP:5000/api
